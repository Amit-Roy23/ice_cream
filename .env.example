# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection string for serverless runtime (with -pooler and ?sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct connection string for Prisma migrations and seeds
DIRECT_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Secret (Used for signing session JWT tokens - generate a 32+ char random string)
AUTH_SECRET="your-super-secret-random-jwt-key-min-32-chars"

# Optional App URL for NextAuth/Absolute URLs
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV="development"
